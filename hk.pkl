amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

steps {
  ["biome"] = Builtins.biome
  ["prettier"] = (Builtins.prettier) {
    glob = List("**/*.md", "**/*.markdown", "**/*.html", "**/*.yml", "**/*.yaml")
  }
  ["actionlint"] = Builtins.actionlint
  ["pinact"] = Builtins.pinact
  ["mise"] = Builtins.mise
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
  }

  ["pre-push"] {
    steps {
      ["typecheck"] {
        check = "mise run typecheck"
      }
      ["test"] {
        check = "mise run test"
      }
    }
  }
}
